---
// Basic Cards grid Section
// ------------
// Description: A grid of cards with basic contact information in a 4 column layout.
// Properties:
// - classes: Additional classes to be added to the Section

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import Card from '../../ui/cards/BasicCard.astro'

// 	Props
type Props = {
	classes?: string
}
const { classes } = Astro.props
---

<Section id="requests" classes={classes}>
	<Row>
		<Col span="12" align="center" classes="mb-12 max-w-4xl mx-auto">
			<h2 class="text-balance">Kanal Komunikasi Resmi <strong>Nokara</strong></h2>
			<p class="pb-0 text-lg">
				Pilih saluran komunikasi yang paling sesuai dengan kebutuhan Anda. Tim kami siap memberikan pendampingan dan solusi terpercaya untuk usaha Anda.
			</p>
		</Col>
	</Row>
	<Row>
		<Col span="3">
			<Card
				title="Bantuan Teknis"
				subtitle="Kendala operasional atau pertanyaan teknis aplikasi? Tim support kami siap mendampingi sistem bisnis Anda."
				icon="shield-check"
				classes="text-center dark:!bg-neutral-800/50"
				link="mailto:support@nokara.id"
			/>
		</Col>
		<Col span="3">
			<Card
				title="Konsultasi & Layanan"
				subtitle="Ingin membuat website toko, aplikasi kasir, atau sistem ERP custom? Konsultasikan kebutuhan Anda."
				icon="document-text"
				classes="text-center dark:!bg-neutral-800/50"
				link="mailto:contact@nokara.id"
			/>
		</Col>
		<Col span="3">
			<Card
				title="Administrasi & Kemitraan"
				subtitle="Kerja sama resmi, administrasi dokumen, atau kemitraan strategis bisnis di Papua dan Indonesia Timur."
				icon="bolt"
				classes="text-center dark:!bg-neutral-800/50"
				link="mailto:admin@nokara.id"
			/>
		</Col>
		<Col span="3" classes="flex flex-col gap-6">
			<Card
				title="Saran & Evaluasi"
				subtitle="Masukan Anda sangat berharga bagi peningkatan mutu layanan dan sistem teknologi Nokara."
				icon="chat-bubble-left-ellipsis"
				classes="text-center dark:!bg-neutral-800/50"
				link="mailto:contact@nokara.id"
			/>
		</Col>
	</Row>
</Section>
