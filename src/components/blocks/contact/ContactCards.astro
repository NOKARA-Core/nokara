---
// Basic Cards grid Section
// ------------
// Description: A grid of cards with basic contact information in a 4 column layout.
// Properties:
// - classes: Additional classes to be added to the Section

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import Card from '../../ui/cards/BasicCard.astro'

// 	Props
type Props = {
	classes?: string
}
const { classes } = Astro.props
---

<Section id="requests" classes={classes}>
	<Row>
		<Col span="12" align="center" classes="mb-12 max-w-4xl mx-auto">
			<h2 class="text-balance">Kanal Komunikasi Resmi <strong>Nokara Community</strong></h2>
			<p class="pb-0 text-lg text-neutral-600 dark:text-neutral-300">
				Pilih saluran komunikasi yang sesuai dengan kebutuhan Anda. Tim pengurus siap menyambut dan mendampingi rekan-rekan talenta IT di Timika, Papua.
			</p>
		</Col>
	</Row>
	<Row>
		<Col span="3">
			<Card
				title="Diskusi & Belajar"
				subtitle="Pertanyaan seputar roadmap 6 bidang keahlian, materi koding, atau kendala teknis jaringan."
				icon="shield-check"
				classes="text-center dark:!bg-neutral-800/50"
				link="mailto:support@nokara.id"
			/>
		</Col>
		<Col span="3">
			<Card
				title="Keanggotaan & Info"
				subtitle="Ingin bergabung dengan grup komunitas, info kopi darat di Timika, atau usulan pemateri."
				icon="document-text"
				classes="text-center dark:!bg-neutral-800/50"
				link="mailto:contact@nokara.id"
			/>
		</Col>
		<Col span="3">
			<Card
				title="Kerja Sama & Mitra"
				subtitle="Kolaborasi bersama sekolah, kampus, yayasan, atau institusi daerah di Timika dan Papua."
				icon="bolt"
				classes="text-center dark:!bg-neutral-800/50"
				link="mailto:admin@nokara.id"
			/>
		</Col>
		<Col span="3" classes="flex flex-col gap-6">
			<Card
				title="Showcase & Saran"
				subtitle="Ingin memamerkan proyek karya member atau memberikan masukan untuk kemajuan komunitas."
				icon="chat-bubble-left-ellipsis"
				classes="text-center dark:!bg-neutral-800/50"
				link="mailto:contact@nokara.id"
			/>
		</Col>
	</Row>
</Section>
