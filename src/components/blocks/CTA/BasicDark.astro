---
// Nokara Digital Transformation Call To Action Section
// ------------
// Description: Centered CTA section with headline, description, trust points, and primary/secondary action buttons.

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import { Icon } from 'astro-icon/components'
import ChipNotification from '../../ui/ChipNotification.astro'
import { Image } from 'astro:assets'
import Highlight from '../../ui/Highlight.astro'

// Content
import badge from '../../../assets/badge.svg'

// Props
type Props = {
	classes?: string
}
const { classes } = Astro.props

const trustPoints = [
	'Akses kurikulum roadmap terstruktur & diskusi teknis praktis',
	'Ruang sharing session santai & kolaborasi sesama pegiat IT Mimika',
	'Showcase proyek karya talenta lokal & terhubung dengan ekosistem NOKARA.ID'
]
---

<Section id="konsultasi-cta" classes={classes}>
	<Row>
		<Col span="1" />
		<Col span="10">
			<div
				class="relative overflow-hidden rounded-2xl border border-primary-500/40 bg-gradient-to-b from-neutral-900/90 via-neutral-950 to-neutral-950 p-8 text-center shadow-2xl shadow-primary-500/10 lg:p-16 backdrop-blur-sm"
			>
				{/* Subtle gold glow backdrop effect */}
				<div
					class="pointer-events-none absolute -top-24 left-1/2 -translate-x-1/2 h-48 w-96 rounded-full bg-primary-500/15 blur-3xl"
					aria-hidden="true"
				></div>

				<div class="relative z-10 max-w-3xl mx-auto flex flex-col items-center">
					<ChipNotification
						radius="rounded-full"
						classes="mb-6 border border-primary-500/30 bg-neutral-900/80 text-neutral-200"
					>
						<Image src={badge} alt="Wadah Komunitas IT Papua" class="h-12 w-12" slot="button" />
						<span class="hidden sm:inline">Wadah Kolaborasi IT &amp; Talenta,</span>
						<Highlight classes="sm:ml-2"> Timika &bull; Papua </Highlight>
					</ChipNotification>

					<h2 class="text-2xl font-bold tracking-tight text-neutral-50 sm:text-3xl lg:text-4xl text-balance">
						Siap Bertumbuh Bersama Komunitas IT Timika?
					</h2>
					<p class="mt-4 text-base text-neutral-300 leading-relaxed sm:text-lg text-balance">
						Baik Anda pemula yang baru mengenal koding, teknisi jaringan lapangan, maupun engineer berpengalaman—pintu Nokara Community selalu terbuka untuk belajar bersama dan memajukan ekosistem teknologi di tanah Papua.
					</p>

					{/* Trust Points */}
					<ul class="my-8 flex flex-col gap-3 text-left sm:gap-3.5">
						{
							trustPoints.map((point) => (
								<li class="flex items-start gap-3 text-sm text-neutral-200 sm:text-base">
									<span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center text-primary-400">
										<Icon name="check-circle" class="h-5 w-5" />
									</span>
									<span>{point}</span>
								</li>
							))
						}
					</ul>

					{/* Action Buttons */}
					<div class="flex flex-col w-full sm:w-auto sm:flex-row items-center justify-center gap-4">
						<a
							href="/contact"
							class="w-full sm:w-auto inline-flex items-center justify-center rounded-lg bg-primary-500 px-6 py-3.5 text-base font-bold text-neutral-950 shadow-lg shadow-primary-500/25 transition-all duration-300 hover:bg-primary-300 hover:shadow-primary-500/40 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 focus:ring-offset-neutral-950"
						>
							Gabung Komunitas Sekarang
						</a>
						<a
							href="https://nokara.id"
							target="_blank"
							rel="noopener noreferrer"
							class="w-full sm:w-auto inline-flex items-center justify-center rounded-lg border-2 border-primary-500/80 bg-transparent px-6 py-3.5 text-base font-semibold text-primary-300 transition-all duration-300 hover:border-primary-400 hover:bg-primary-500/10 hover:text-primary-200 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 focus:ring-offset-neutral-950"
						>
							Kunjungi Induk NOKARA.ID
						</a>
					</div>
				</div>
			</div>
		</Col>
		<Col span="1" />
	</Row>
</Section>
