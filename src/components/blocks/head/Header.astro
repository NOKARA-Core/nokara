---
// Imports
import { ClientRouter } from 'astro:transitions'
import GoogleAnalytics from '../../scripts/googleAnalytics.astro'
import GoogleTagManagerHead from '../../scripts/googleTagManagerHead.astro'
import GoogleSearchConsole from '../../scripts/googleSearchConsole.astro'
// Partials
import Seo from './partials/Seo.astro'
// Data
import { configData } from '../../../config/config'

import { googleAnalyticsMeasurementID } from '../../../config/analytics'
import { googleTagManagerID } from '../../../config/analytics'

// Props
type Props = {
	title?: string
	description?: string
	ogImage?: string
	canonical?: boolean
	noindex?: boolean
}
// Page Metadata
const {
	title = configData.siteTitle,
	description = configData.siteDescription,
	ogImage = configData.ogImage,
	canonical = configData.canonical,
	noindex = configData.noindex
} = Astro.props

const siteOrigin = Astro.site ? new URL(Astro.site).origin : (Astro.url ? Astro.url.origin : 'https://nokara.biz.id')
---

<head>
	{googleAnalyticsMeasurementID && <GoogleAnalytics />}
	{googleTagManagerID && <GoogleTagManagerHead />}
	<GoogleSearchConsole />
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<Seo
		title={title}
		description={description}
		ogImage={ogImage}
		canonical={canonical}
		noindex={noindex}
	/>
	<link rel="icon" href="/Logo-Nokara-Dark.png" type="image/png" />
	<link rel="icon" href="/S-Logo-Nokara-Dark.svg" type="image/svg+xml" sizes="any" />
	<link rel="apple-touch-icon" href="/Logo-Nokara-Dark.png" />
	<link rel="sitemap" href="/sitemap-index.xml" />
	<meta name="generator" content={Astro.generator} />
	<meta name="theme-color" content="#AA820A" />
	<script
		type="application/ld+json"
		is:inline
		set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'Organization',
			name: 'Nokara Community',
			url: siteOrigin,
			logo: `${siteOrigin}/Logo-Nokara-Dark.png`,
			image: `${siteOrigin}/Logo-Nokara-Dark.png`,
			description: 'Platform komunitas IT, wadah belajar rekayasa perangkat lunak, dan showcase karya talenta digital di Timika, Papua. Bagian dari inisiatif ekosistem NOKARA.ID.',
			founder: {
				'@type': 'Person',
				name: 'Muhammad Amin Hidayat',
				url: 'https://nokara.id'
			},
			contactPoint: [
				{
					'@type': 'ContactPoint',
					email: 'contact@nokara.id',
					contactType: 'general inquiry'
				},
				{
					'@type': 'ContactPoint',
					email: 'support@nokara.id',
					contactType: 'technical support'
				}
			],
			sameAs: ['https://nokara.id']
		})}
	/>
	<ClientRouter fallback="swap" />
</head>
