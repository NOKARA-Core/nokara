---
// Basic FAQ section
// ------------
// Description: A section that contains a list of frequently asked questions with answers.

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import Accordion from '../../ui/Accordion.astro'
import Card from '../../ui/cards/partials/Card.astro'

// Props
type Props = {
	classes?: string
}
const { classes } = Astro.props
---

<Section id="FAQ" classes={classes}>
	<Row>
		<Col span="12" align="center" classes="mb-12 max-w-4xl mx-auto">
			<h2 class="text-pretty">
				Pertanyaan Umum seputar <strong>Roadmap Belajar</strong>
			</h2>
			<p class="text-lg leading-relaxed">
				Membantu Anda memahami alur belajar, kesiapan perangkat, dan orientasi proyek nyata untuk talenta digital di Papua & Indonesia Timur.
			</p>
		</Col>
		<Col span="2" />
		<Col span="8">
			<Card classes="divide-y divide-neutral-100 dark:divide-neutral-800">
				<Accordion
					title="Apakah saya harus memiliki latar belakang IT untuk memulai?"
					text="Tidak harus. Kurikulum Level 1 dirancang dari fondasi dasar (fundamental), mulai dari pemahaman jaringan fisik, logika pemrograman dasar, hingga pembuatan website statis yang ramah bagi pemula."
				/>
				<Accordion
					title="Apakah materi dapat dipelajari dengan spesifikasi laptop standar?"
					text="Ya. Seluruh modul Level 1 dan Level 2 dirancang agar ringan dan dapat dijalankan di laptop standar tanpa memerlukan perangkat komputer mahal atau laptop gaming berspesifikasi tinggi."
				/>
				<Accordion
					title="Bagaimana jika koneksi internet di wilayah saya sering terbatas?"
					text="Kurikulum kami menekankan pendekatan arsitektur offline-first dan sistem lokal. Anda akan belajar membangun aplikasi yang tetap andal berfungsi secara lokal dan tersinkronisasi saat jaringan tersedia."
				/>
				<Accordion
					title="Apakah ada sesi bimbingan atau konsultasi langsung?"
					text="Tentu. Anda dapat berkonsultasi langsung dengan tim engineer Nokara melalui kanal kontak resmi untuk mendiskusikan arah karir, tantangan kode, ataupun penerapan proyek lokal nyata."
				/>
				<Accordion
					title="Keluaran apa yang saya dapatkan setelah menyelesaikan kurikulum ini?"
					text="Anda akan memiliki portofolio proyek terapan konkret: mulai dari setup jaringan lokal kantor, sistem kasir toko & aplikasi inventaris (POS), hingga pengelolaan server mandiri dan integrasi kecerdasan buatan."
				/>
			</Card>
		</Col>
		<Col span="2" />
	</Row>
</Section>

<style>
	.page-header {
		@apply mx-auto max-w-3xl;
	}
	.page-header__text {
		@apply text-lg leading-relaxed;
	}
</style>
