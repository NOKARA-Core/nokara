---
// Feature Cards grid Section
// ------------
// Description: A grid of cards with feature information in a 4 column layout.

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import Card from '../../ui/cards/FeatureCard.astro'

// Content
// - Cards
import feature01 from '../../../assets/cards/feature-01.svg'
import feature02 from '../../../assets/cards/feature-02.svg'
import feature03 from '../../../assets/cards/Nokav22.svg'
import feature04 from '../../../assets/cards/feature-04.svg'
import feature05 from '../../../assets/cards/feature-05.svg'
---

<Section id="features">
	<Row>
		<Col span="12" align="center" classes="mb-12 max-w-4xl mx-auto">
			<h2 class="text-pretty">Aktivitas &amp; Pilar <strong>Gerakan Komunitas</strong></h2>
			<p class="pb-0 text-lg text-neutral-600 dark:text-neutral-300">
				Dari belajar koding mandiri, bedah infrastruktur jaringan, hingga merilis proyek nyata. Inilah ruang bertumbuh bagi talenta IT di Mimika dan Papua.
			</p>
		</Col>
	</Row>
	<Row>
		<Col span="4">
			<Card
				title="Roadmap Talenta Terarah"
				subtitle="Panduan kurikulum mandiri 6 bidang rekayasa: Jaringan, Pemrograman, Web, Mobile Offline-First, Linux DevOps, dan AI Terapan yang relevan dengan kebutuhan lapangan daerah."
				image={feature01}
				link="/education"
			/>
		</Col>
		<Col span="4" classes="flex flex-col gap-6">
			<Card
				title="Showcase Karya Member"
				subtitle="Pameran hasil karya aplikasi, sistem kasir, dan portofolio teknologi yang dikembangkan oleh anggota komunitas di Timika."
				image={feature02}
				link="/features"
			/>
			<Card
				title="Kopi Darat &amp; Diskusi Teknis"
				subtitle="Temu rutin pegiat IT, sharing session santai, dan bedah masalah eror koding atau kendala jaringan bersama."
				image={feature03}
				link="/contact"
			/>
		</Col>
		<Col span="4" classes="flex flex-col gap-6">
			<Card
				title="Mentoring Praktisi Industri"
				subtitle="Bimbingan teknis dan review arsitektur sistem langsung bersama tim engineer dari ekosistem NOKARA.ID."
				image={feature04}
				link="https://nokara.id"
			/>
			<Card
				title="Solusi Nyata Tantangan Daerah"
				subtitle="Fokus pada rekayasa tangguh: aplikasi tahan koneksi terbatas, otomasi usaha lokal, dan keamanan data instansi."
				image={feature05}
				link="/education"
			/>
		</Col>
	</Row>
</Section>
