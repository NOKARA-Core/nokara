---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - UI
import FormHero from '../components/blocks/hero/ContactHero.astro'
import ContactCards from '../components/blocks/contact/ContactCards.astro'
import SocialProof from '../components/blocks/socialproof/Basic.astro'

// Content
// - SEO
const SEO = {
	title: 'Hubungi Tim Nokara | Solusi Bisnis Digital Timika Papua',
	description:
		'Hubungi tim ahli Nokara untuk konsultasi sistem kasir, pembuatan website, dan digitalisasi usaha Anda di Timika & Papua. Respon cepat dan profesional.'
}
// - Page Header
const header = {
	title: 'Konsultasikan Kebutuhan Bisnis Anda Bersama <strong>Nokara</strong>.',
	text: "Ada pertanyaan seputar sistem kasir, pembuatan website toko, atau rekayasa sistem khusus? Tim Nokara siap membantu dan mendampingi transformasi digital usaha Anda."
}
---

<Layout title={SEO.title} description={SEO.description}>
	<FormHero
		title={header.title}
		text={header.text}
		id="contact"
		classes="bg-neutral-50 dark:bg-neutral-950/80"
	/>
	<ContactCards classes="dark:bg-neutral-950/80" />
	<SocialProof classes="dark:bg-neutral-950/80" />
</Layout>
