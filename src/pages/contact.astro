---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - UI
import FormHero from '../components/blocks/hero/ContactHero.astro'
import ContactCards from '../components/blocks/contact/ContactCards.astro'
import SocialProof from '../components/blocks/socialproof/Basic.astro'
import CTA from '../components/blocks/CTA/BasicDark.astro'

// Content
// - SEO
const SEO = {
	title: 'Hubungi Nokara Community | Komunitas IT Timika Papua',
	description:
		'Hubungi pengurus Nokara Community untuk bergabung, konsultasi roadmap belajar, usulan sharing session, atau kolaborasi talenta digital di Timika, Papua.'
}
// - Page Header
const header = {
	title: 'Terhubung &amp; Berkolaborasi Bersama <strong>Nokara Community</strong>',
	text: 'Ada pertanyaan seputar cara bergabung, usulan materi sharing session, atau ingin bekerja sama memajukan talenta digital di Timika? Tim pengurus siap menyambut Anda.'
}
---

<Layout title={SEO.title} description={SEO.description}>
	<FormHero
		title={header.title}
		text={header.text}
		id="contact"
		classes="bg-neutral-50 dark:bg-neutral-950/80"
	/>
	<ContactCards classes="dark:bg-neutral-950/80" />
	<SocialProof classes="dark:bg-neutral-950/80" />
	<CTA />
</Layout>
