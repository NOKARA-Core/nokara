---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - UI
import Feature from '../components/blocks/features/FeatureSticky.astro'
import Hero from '../components/blocks/hero/PageHeader.astro'
import CTA from '../components/blocks/CTA/BasicDark.astro'

// Member Projects Data
const umkmProjects = [
	{
		title: 'Kasir Cepat Offline-First',
		icon: 'shopping-cart',
		description:
			'Aplikasi kasir toko mandiri yang tetap beroperasi normal saat jaringan mati, lalu menyinkronkan data penjualan otomatis ketika perangkat terhubung sinyal kembali.'
	},
	{
		title: 'Pencatatan Stok Gudang Sederhana',
		icon: 'circle-stack',
		description:
			'Sistem pembukuan stok barang masuk-keluar yang ramah ponsel spesifikasi standar, dibuat untuk meminimalisir selisih persediaan toko lokal.'
	},
	{
		title: 'Estimasi Logistik & Distribusi Daerah',
		icon: 'arrow-trending-up',
		description:
			'Alat bantu hitung estimasi ongkos logistik antardistrik berbasis rute transportasi perintis dan darat di kawasan Mimika.'
	}
]

const networkProjects = [
	{
		title: 'Monitoring Uptime MikroTik',
		icon: 'bolt',
		description:
			'Sistem notifikasi peringatan dini via Telegram saat router kantor distrik atau tautan radio Point-to-Point terputus.'
	},
	{
		title: 'Captive Portal Hotspot Ringan',
		icon: 'device-phone-mobile',
		description:
			'Halaman masuk WiFi publik yang sangat hemat data dan cepat dimuat, cocok untuk balai desa, sekolah, atau komunitas lokal.'
	},
	{
		title: 'Otomasi Cadangan Database Server',
		icon: 'shield-check',
		description:
			'Script terjadwal untuk mencadangkan database sistem administrasi kantor secara terenkripsi guna mencegah kehilangan data penting.'
	}
]

const webProjects = [
	{
		title: 'Direktori Usaha & Jasa Mimika',
		icon: 'computer-desktop',
		description:
			'Portal direktori berbasis situs statis super cepat agar warga Timika mudah menemukan kontak teknisi, bengkel, dan usaha lokal.'
	},
	{
		title: 'Sistem Arsip Berkas Digital Sekolah',
		icon: 'document-chart-bar',
		description:
			'Aplikasi pengarsipan surat masuk dan keluar berbasis jaringan lokal (LAN) sekolah tanpa memerlukan biaya sewa cloud bulanan.'
	},
	{
		title: 'Ruang Diskusi & Bantuan Teknis',
		icon: 'chat-bubble-left-right',
		description:
			'Pusat arsip solusi error pemrograman dan konfigurasi jaringan yang pernah dihadapi anggota komunitas saat bertugas di lapangan.'
	}
]

// Content
// - SEO
const SEO = {
	title: 'Karya & Proyek Member Komunitas | Nokara Community Timika',
	description:
		'Showcase aplikasi, sistem kasir offline, dan infrastruktur jaringan karya pegiat IT Nokara Community di Timika, Papua. Bagian dari NOKARA.ID.'
}
// - Page Header
const header = {
	title: 'Karya Nyata & Inovasi <strong>Member Komunitas</strong>',
	text: 'Etalase proyek perangkat lunak, sistem kasir mandiri, dan solusi jaringan yang dibangun oleh talenta IT lokal di Timika, Papua.'
}
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text} />
	<Feature
		title="Solusi UMKM & Lapangan"
		text="Aplikasi tangguh dan hemat kuota yang menjawab kebutuhan operasional pelaku usaha di Mimika."
		data={umkmProjects}
	/>
	<Feature
		title="Jaringan & Infrastruktur"
		text="Konfigurasi jaringan andal dan otomasi server yang dirancang oleh teknisi jaringan daerah."
		data={networkProjects}
		classes="bg-neutral-50 dark:bg-neutral-900"
	/>
	<Feature
		title="Web Portal & Layanan Warga"
		text="Situs informasi ringan dan sistem administrasi sekolah tanpa ketergantungan server mahal."
		data={webProjects}
	/>
	<CTA />
</Layout>
