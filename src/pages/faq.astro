---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - UI
import Hero from '../components/blocks/hero/PageHeader.astro'
import FAQ from '../components/blocks/FAQ/FaqSticky.astro'
import TextImage from '../components/blocks/basic/TextImage.astro'
import CTA from '../components/blocks/CTA/BasicDark.astro'

// Data
import faqData from '../data/json-files/faqData.json'
// - FAQ Categories
const faqMembership = faqData.filter((faq) => faq.category === 'membership')
const faqEcosystem = faqData.filter((faq) => faq.category === 'ecosystem')

// Content
import faqImage1 from '../assets/faq/faq-01.png'
// - SEO
const SEO = {
	title: 'Tanya Jawab Komunitas (FAQ) | Nokara Community Timika',
	description:
		'Jawaban lengkap seputar cara bergabung, kegiatan belajar, kopi darat, dan dukungan ekosistem NOKARA.ID di Timika, Papua.'
}
// - Page Header
const header = {
	title: 'Pertanyaan yang Sering Diajukan Seputar <strong>Nokara Community</strong>',
	text: 'Temukan jawaban lengkap seputar cara bergabung, kurikulum belajar, temu komunitas di Timika, dan kolaborasi karya.'
}
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text} />
	<FAQ
		title="Keanggotaan & Kegiatan"
		text="Pertanyaan umum seputar syarat bergabung, biaya, agenda kopi darat, dan alur belajar bagi pemula."
		data={faqMembership}
	/>
	<TextImage
		title="Tumbuh Bersama dari Tanah Papua"
		text="Nokara Community hadir bukan sebagai kursus berbayar, melainkan wadah nirlaba berfilosofi Noken Papua untuk saling membagikan ilmu, memecahkan kendala teknis bersama, dan membuka jalan bagi talenta lokal menuju industri teknologi profesional."
		image={faqImage1}
		mobileImage={faqImage1}
		imagePosition="left"
		offsetImage
		classes="bg-neutral-50 dark:bg-neutral-900 lg:!py-64"
	/>
	<FAQ
		title="Ekosistem & Karya Member"
		text="Informasi mengenai relasi komunitas dengan induk NOKARA.ID, akses materi kurikulum, dan pengajuan karya proyek."
		data={faqEcosystem}
	/>
	<CTA />
</Layout>
