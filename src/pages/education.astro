---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - UI
import Hero from '../components/blocks/hero/PageHeader.astro'
import TrackCards from '../components/blocks/education/TrackCards.astro'
import SocialProof from '../components/blocks/socialproof/Basic.astro'
import FAQ from '../components/blocks/FAQ/Basic.astro'
import Testimonial from '../components/blocks/testimonials/BasicDark.astro'
import Feature from '../components/blocks/features/FeatureList.astro'
import CTA from '../components/blocks/CTA/BasicDark.astro'

// Content
// - SEO
const SEO = {
	title: 'Roadmap Talenta Digital: Pilih Jalur Keahlian Anda | Nokara',
	description:
		'Panduan kurikulum belajar mandiri yang disusun terpisah per bidang. Realistis, relevan dengan kebutuhan lapangan di Papua dan kawasan timur, dari dasar hingga siap kerja.'
}
// - Page Header
const header = {
	title: 'Roadmap Talenta Digital: <strong>Pilih Jalur Keahlian Anda</strong>',
	text: 'Panduan kurikulum belajar mandiri yang disusun terpisah per bidang. Realistis, relevan dengan kebutuhan lapangan di Papua dan kawasan timur, dari dasar hingga siap kerja.'
}
// - Testimonial data
import testimonialBackground from '../assets/testi2.png'
const testimonialData = {
	blockquote:
		'Membangun ekosistem teknologi yang inklusif di Papua adalah kunci pemberdayaan ekonomi lokal. Setiap baris kode yang kami tulis adalah investasi bagi masa depan digital tanah Papua.',
	figcaption: 'Muhammad Amin Hidayat',
	cite: 'Founder, Nokara, M.Sc in Computer Science'
}
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text} />
	<TrackCards />
	<SocialProof />
	<Feature />
	<Testimonial
		bg={testimonialBackground}
		bgPosition="left"
		blockquote={testimonialData.blockquote}
		figcaption={testimonialData.figcaption}
		cite={testimonialData.cite}
	/>
	<FAQ classes="bg-slate-50 dark:bg-neutral-900/40" />
	<CTA />
</Layout>
